{
  "_readme": "Excel 클립보드 text/plain(탭 구분) 형식을 가정한 합성 사례. 실제 Excel·Teams 클립보드로 검증하지 않음. docs/samples/README.md 참고.",
  "format": {
    "raw": "클립보드 text/plain 원문(JSON 문자열, \\t \\n \\r\\n 포함)",
    "expected": "파서가 돌려줄 행×열 문자열 2차원 배열. 거부 사례는 null + expected_error",
    "expected_error": "거부 사례의 메시지(문구는 예시)",
    "reference_parser_diff": "참고 코드(react-datasheet-grid)와 다른 점"
  },
